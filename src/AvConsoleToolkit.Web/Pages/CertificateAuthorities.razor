@page "/cas"
@using AvConsoleToolkit.CertManager
@using AvConsoleToolkit.Web.ViewModels
@implements IDisposable

<h1 class="page-title">Certificate Authorities</h1>

@if (!string.IsNullOrEmpty(_vm.StatusMessage))
{
    <div class="alert @(_vm.IsError ? "alert-danger" : "alert-success")">
        @_vm.StatusMessage
    </div>
}

<div class="card">
    <h3>Create New CA</h3>
    <div class="form-row">
        <div class="form-group">
            <label>Name</label>
            <input @bind="_vm.NewCaName" placeholder="my-ca" />
        </div>
        <div class="form-group">
            <label>Organization</label>
            <input @bind="_vm.NewCaOrg" placeholder="MyOrg" />
        </div>
        <div class="form-group">
            <label>Country</label>
            <input @bind="_vm.NewCaCountry" placeholder="US" maxlength="2" />
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label>Org Unit (optional)</label>
            <input @bind="_vm.NewCaOu" placeholder="IT" />
        </div>
        <div class="form-group">
            <label>State (optional)</label>
            <input @bind="_vm.NewCaState" placeholder="California" />
        </div>
        <div class="form-group">
            <label>Locality (optional)</label>
            <input @bind="_vm.NewCaLocality" placeholder="San Francisco" />
        </div>
    </div>
    <div class="form-group">
        <label>Validity (days)</label>
        <input type="number" @bind="_vm.NewCaValidityDays" style="width:150px" />
    </div>
    <button class="btn btn-primary" @onclick="CreateCa"
            disabled="@(string.IsNullOrWhiteSpace(_vm.NewCaName) || string.IsNullOrWhiteSpace(_vm.NewCaOrg) || string.IsNullOrWhiteSpace(_vm.NewCaCountry))">
        Create CA
    </button>
</div>

<div class="card">
    <h3>Existing CAs</h3>
    @if (_vm.CertificateAuthorities.Count == 0)
    {
        <p style="color:#666">No Certificate Authorities found.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Organization</th>
                    <th>Country</th>
                    <th>Created</th>
                    <th>Expires</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ca in _vm.CertificateAuthorities)
                {
                    var remaining = (ca.ExpiresUtc - DateTime.UtcNow).TotalDays;
                    <tr>
                        <td>@ca.Id</td>
                        <td><strong>@ca.Name</strong></td>
                        <td>@ca.Organization</td>
                        <td>@ca.Country</td>
                        <td>@ca.CreatedUtc.ToString("yyyy-MM-dd")</td>
                        <td>@ca.ExpiresUtc.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (remaining <= 0)
                            {
                                <span class="badge badge-danger">Expired</span>
                            }
                            else if (remaining <= 90)
                            {
                                <span class="badge badge-warning">@((int)remaining) days</span>
                            }
                            else
                            {
                                <span class="badge badge-success">Valid</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteCa(ca.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Inject] private CertDatabase Db { get; set; } = default!;
    private CaViewModel _vm = default!;

    protected override void OnInitialized()
    {
        _vm = new CaViewModel(Db.DatabasePath);
        _vm.PropertyChanged += (_, _) => InvokeAsync(StateHasChanged);
    }

    private void CreateCa()
    {
        _vm.CreateCaCommand.Execute().Subscribe();
    }

    private void DeleteCa(int id)
    {
        _vm.DeleteCaCommand.Execute(id).Subscribe();
    }

    public void Dispose()
    {
        // ViewModel disposal handled by GC
    }
}
