@page "/devices"
@using AvConsoleToolkit.CertManager
@using AvConsoleToolkit.Web.ViewModels
@implements IDisposable

<h1 class="page-title">Device Certificates</h1>

@if (!string.IsNullOrEmpty(_vm.StatusMessage))
{
    <div class="alert @(_vm.IsError ? "alert-danger" : "alert-success")">
        @_vm.StatusMessage
    </div>
}

<div class="card">
    <h3>Create New Device Certificate</h3>
    <div class="form-row">
        <div class="form-group">
            <label>Name</label>
            <input @bind="_vm.NewName" placeholder="web-server" />
        </div>
        <div class="form-group">
            <label>Signing CA</label>
            <select @bind="_vm.SelectedCaName">
                <option value="">-- Select CA --</option>
                @foreach (var ca in _vm.AvailableCas)
                {
                    <option value="@ca">@ca</option>
                }
            </select>
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label>DNS Names (comma-separated)</label>
            <input @bind="_vm.DnsNames" placeholder="server.example.com, server.local" />
        </div>
        <div class="form-group">
            <label>IP Addresses (optional, comma-separated)</label>
            <input @bind="_vm.IpAddresses" placeholder="192.168.1.100" />
        </div>
    </div>
    <div class="form-group">
        <label>Validity (days)</label>
        <input type="number" @bind="_vm.ValidityDays" style="width:150px" />
    </div>
    <button class="btn btn-primary" @onclick="CreateCert"
            disabled="@(string.IsNullOrWhiteSpace(_vm.NewName) || string.IsNullOrWhiteSpace(_vm.SelectedCaName) || string.IsNullOrWhiteSpace(_vm.DnsNames))">
        Create Certificate
    </button>
</div>

<div class="card">
    <h3>Existing Device Certificates</h3>
    @if (_vm.DeviceCertificates.Count == 0)
    {
        <p style="color:#666">No device certificates found.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>DNS Names</th>
                    <th>IP Addresses</th>
                    <th>Created</th>
                    <th>Expires</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cert in _vm.DeviceCertificates)
                {
                    var remaining = (cert.ExpiresUtc - DateTime.UtcNow).TotalDays;
                    <tr>
                        <td>@cert.Id</td>
                        <td><strong>@cert.Name</strong></td>
                        <td>@cert.DnsNames</td>
                        <td>@cert.IpAddresses</td>
                        <td>@cert.CreatedUtc.ToString("yyyy-MM-dd")</td>
                        <td>@cert.ExpiresUtc.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (remaining <= 0)
                            {
                                <span class="badge badge-danger">Expired</span>
                            }
                            else if (remaining <= 30)
                            {
                                <span class="badge badge-warning">@((int)remaining) days</span>
                            }
                            else
                            {
                                <span class="badge badge-success">Valid (@((int)remaining)d)</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteCert(cert.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Inject] private CertDatabase Db { get; set; } = default!;
    private DeviceCertViewModel _vm = default!;

    protected override void OnInitialized()
    {
        _vm = new DeviceCertViewModel(Db.DatabasePath);
        _vm.PropertyChanged += (_, _) => InvokeAsync(StateHasChanged);
    }

    private void CreateCert()
    {
        _vm.CreateCertCommand.Execute().Subscribe();
    }

    private void DeleteCert(int id)
    {
        _vm.DeleteCertCommand.Execute(id).Subscribe();
    }

    public void Dispose()
    {
    }
}
